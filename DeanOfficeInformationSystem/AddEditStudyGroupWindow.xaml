<Window x:Class="DeanOfficeInformationSystem.AddEditStudyGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeanOfficeInformationSystem"
        mc:Ignorable="d"
        Title="Редактирование группы" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#E8EDF3">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC6CF"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC6CF"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C4D68"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="windowTitle" Grid.Row="0" Text="Редактирование группы" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C4D68"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название группы:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtGroupName"/>

                <TextBlock Text="Курс:" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbCourse">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                </ComboBox>

                <TextBlock Text="Специальность:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSpeciality"/>

                <TextBlock Text="Год формирования:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFormationYear"/>

                <TextBlock Text="Староста:" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbHeadman" DisplayMemberPath="LastName"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnCancel" Content="Отмена" Style="{StaticResource ActionButton}" Background="#909DAE" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" Style="{StaticResource ActionButton}" Background="#61A64A" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window> 