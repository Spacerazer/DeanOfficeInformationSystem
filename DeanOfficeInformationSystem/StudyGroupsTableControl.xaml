<UserControl x:Class="DeanOfficeInformationSystem.StudyGroupsTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeanOfficeInformationSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Курс:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="courseFilter" Width="100" Margin="0,0,15,0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="6"/>
            </ComboBox>

            <TextBlock Text="Специальность:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="specialityFilter" Width="200" SelectionChanged="Filter_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="groupsDataGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  AlternatingRowBackground="#F5F9FF"
                  SelectionChanged="groupsDataGrid_SelectionChanged"
                  BorderBrush="#6E8BAD"
                  RowBackground="#FFFFFF">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8EDF3"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название группы" Binding="{Binding GroupName}" Width="120"/>
                <DataGridTextColumn Header="Курс" Binding="{Binding Course}" Width="60"/>
                <DataGridTextColumn Header="Специальность" Binding="{Binding Speciality}" Width="200"/>
                <DataGridTextColumn Header="Год формирования" Binding="{Binding FormationYear}" Width="120"/>
                <DataGridTextColumn Header="Староста" Binding="{Binding HeadmanFullName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl> 